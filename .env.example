# 数据库（PostgreSQL + Prisma）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobpilot?schema=public"

# V1 允许使用外部 LLM API；用户数据默认按 userId 隔离
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL=""

# 事实层开关：确定性校验不可关闭（T5 硬约束，仅保留此项用于调试日志）
FACT_GUARD_LOG="true"

# 用户自带 LLM API Key 的主密钥（Migration #19；AES-256-GCM 可逆加密）
# 必须是 32 字节：hex 64 字符或 base64url 43 字符。缺失/格式错时用户 Key 功能 fail-fast。
# ⚠️ 禁止使用随机值兜底：主密钥丢失后所有已保存的用户 Key 将无法解密（需用户重填）。
LLM_USER_KEY_MASTER_SECRET=""

# JD preview token 签名密钥（src/domain/jd/preview-token.ts 消费）
# 缺失时回退 randomBytes(32)——仅影响 token 有效性跨重启，不影响用户 Key 功能。
JD_PREVIEW_SECRET=""

# dev-only 引导账号（scripts/dev-bootstrap-account.mjs；仅本地开发/测试，无默认值）
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=

# handler 层每小时 LLM 调用配额（jds / matches / suggestions 共用同一 `llm:<userId>` 桶）。
# 未设置时回落各 handler 内置默认值 20。注意 matches 按「每条未确定性命中的 JD 要求」逐次扣，
# 单次匹配的消耗量 = 该 JD 走语义匹配的要求条数（实测某 JD 为 18 条）。
LLM_QUOTA_PER_HOUR=200
